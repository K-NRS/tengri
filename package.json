{
  "name": "tengri",
  "version": "0.2.1",
  "description": "Old Turkic (Göktürk / Orkhon) script transliterator, plus a random line from the Orkhon inscriptions or Kutadgu Bilig in Turkish and English. Try: npx tengri",
  "keywords": [
    "göktürk",
    "orkhon",
    "old-turkic",
    "transliteration",
    "unicode",
    "kutadgu-bilig",
    "tengri",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "tengri": "bin/tengri.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "bin",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K-NRS/tengri.git"
  },
  "homepage": "https://github.com/K-NRS/tengri#readme",
  "bugs": {
    "url": "https://github.com/K-NRS/tengri/issues"
  }
}
